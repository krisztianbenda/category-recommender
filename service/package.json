{
  "name": "catrec-service",
  "version": "0.1.0",
  "private": true,
  "description": "Local, privacy-first email category recommender",
  "type": "module",
  "engines": {
    "node": ">=24.18 <25"
  },
  "bin": {
    "catrec": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "eval": "tsx tests/eval/run.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "pino-roll": "4.0.0",
    "ulid": "3.0.2",
    "undici": "8.12.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
