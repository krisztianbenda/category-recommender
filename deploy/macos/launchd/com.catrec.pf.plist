<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS does not enable pf at boot; this loads /etc/pf.conf (with the catrec anchor) on boot. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.catrec.pf</string>
  <key>ProgramArguments</key>
  <array>
    <string>/sbin/pfctl</string><string>-E</string><string>-f</string><string>/etc/pf.conf</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
